# ==============================================================================
# CONFIGURAÇÃO UNIFICADA - MONITOR LEGISLATIVO
# ==============================================================================
# Este arquivo contém as variáveis para Docker (Backend, Frontend, DB, Redis).
# Para desenvolvimento local (fora do Docker), você ainda pode usar .env
# dentro das pastas /backend ou /frontend se necessário.

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_DB=monitor_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=senha123
# Use 'db' para rodar via Docker Compose, ou 'localhost' para rodar localmente
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Interface (pgAdmin) ---
PGADMIN_DEFAULT_EMAIL=dev@projeto.local
PGADMIN_DEFAULT_PASSWORD=admin_password

# --- Cache e Bloqueio (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
TENTATIVAS_MAXIMAS=5
BLOQUEIO_MINUTOS=15

# --- Segurança e Autenticação (Backend) ---
SECRET_KEY=sua-chave-secreta-de-desenvolvimento-muito-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend & CORS ---
# URL da API que o Frontend (Vite) irá consumir
VITE_API_URL=http://localhost:8000

# Origens permitidas pelo backend (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Regras de Negócio ---
THRESHOLD_MINIMO_AMOSTRA_ESTIMATIVA=50
